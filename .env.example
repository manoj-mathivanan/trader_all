# Optional Basic Auth for the LOCAL RESEARCH app. Set both in the process environment.
# The server fails to start if only one is configured.
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD=
# Enter the Upstox token in Settings, never here. PostgreSQL saves it encrypted.
# Python does not load this file automatically. Supply variables explicitly.
TRADER_PUBLIC_ORIGIN=
TRADER_DATA_DIR=
TRADER_PRIVATE_DIR=
TRADER_ENV=local
# Use start.ps1 for the protected local connection and private SSH tunnel.
# Database mode requires a completed, verified import; it never falls back to files.
TRADER_STORAGE=postgres
TRADER_DB_DSN_FILE=
TRADER_DB_NAMESPACE=local
TRADER_KEY_FILE=
# Automatic company web research. Set these in the process environment, never commit a key.
# No model is selected automatically. Choose one supporting Responses web search and structured outputs.
OPENAI_API_KEY=
TRADER_NEWS_MODEL=
# Remote deployment uses https://trader.manojmathivanan.com and /srv/trader storage.
